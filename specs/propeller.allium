-- allium: 3
-- propeller.allium
--
-- Specification for the propeller-engine live-coding MIDI loop daemon.
--
-- Scope: project authoring, playback engine, sync clock receiver, daemon lifecycle
-- Excludes:
--   Unix socket / IPC transport (infrastructure)
--   Logging subsystem (infrastructure)
--   Scheduler timing implementation (infrastructure)
--   Process daemonisation (infrastructure)
--   MIDI hardware driver (midir crate)

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    engine: Engine
    store: ProjectStore
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Note {
    start_tick: Integer  -- 0 ≤ start_tick < loop_duration of containing project
    duration: Integer    -- > 0; start_tick + duration ≤ 2 × loop_duration
    pitch: Integer       -- 0–127
    velocity: Integer    -- 0–127
}

value TrackSpec {
    name: String
    channel: Integer        -- 1–16 (MIDI channel)
    instrument: Integer     -- 0–127 (General MIDI program number)
    notes: List<Note>
}

value ProjectData {
    bpm: Integer            -- 20–300, whole number only
    loop_duration: Integer  -- > 0; total loop length in ticks
    tracks: List<TrackSpec>
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum EngineMode { standalone | clock | sync }

enum SyncClockStatus { waiting | tracking | lost }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Engine {
    mode: EngineMode
    state: stopped | waiting | running | paused
    sync_clock_status: SyncClockStatus?  -- null when mode != sync
    last_pulse_at: Timestamp?            -- set on each 0xF8 pulse; null when not in sync mode
    last_pulse_interval: Duration?       -- interval between the two most recent pulses; null until two pulses received

    transitions state {
        stopped  -> running
        stopped  -> waiting
        waiting  -> running
        waiting  -> stopped
        running  -> paused
        running  -> stopped
        paused   -> running
        paused   -> stopped
    }

    clock_loss_deadline: last_pulse_at + last_pulse_interval * config.clock_loss_multiplier
    is_clock_active: clock_loss_deadline >= now
}

entity ProjectStore {
    active: ProjectData?
    pending: ProjectData?
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    ppqn: Integer = 480              -- ticks per quarter note; defines the note-authoring resolution
    clock_ppq: Integer = 24          -- MIDI clock pulses per quarter note (MIDI 1.0 specification)
    bpm_default: Integer = 120       -- BPM used for status responses when no project is loaded
    clock_loss_multiplier: Integer = 4  -- clock declared lost after this many observed intervals (~3.5 in practice)
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Project management

rule CreateProject {
    when: CreateProject(operator, data)

    requires: data.bpm >= 20 and data.bpm <= 300
    requires: data.loop_duration > 0
    requires: data.tracks.all(t =>
        t.channel >= 1
        and t.channel <= 16
        and t.instrument <= 127
        and t.notes.all(n =>
            n.start_tick >= 0
            and n.start_tick < data.loop_duration
            and n.duration > 0
            and n.start_tick + n.duration <= 2 * data.loop_duration
        )
    )

    ensures: store.active = data
    ensures: store.pending = null
    ensures:
        if engine.state = waiting:
            engine.state = running
    -- Immediately activates the project. If the engine was Waiting for a project,
    -- playback starts at once from loop start.
}

rule ModifyProject {
    when: ModifyProject(operator, data)

    requires: data.bpm >= 20 and data.bpm <= 300
    requires: data.loop_duration > 0
    requires: data.tracks.all(t =>
        t.channel >= 1
        and t.channel <= 16
        and t.instrument <= 127
        and t.notes.all(n =>
            n.start_tick >= 0
            and n.start_tick < data.loop_duration
            and n.duration > 0
            and n.start_tick + n.duration <= 2 * data.loop_duration
        )
    )

    ensures: store.pending = data
    -- Always accepted regardless of engine state.
    -- The pending project takes effect at the next loop boundary (see PendingAppliedAtLoopBoundary).
    -- If the engine is stopped, pending is applied when playback next starts.
}

rule SetBpm {
    when: SetBpm(operator, bpm)

    requires: engine.mode != sync    -- set-bpm is rejected in sync mode
    requires: bpm >= 20 and bpm <= 300

    ensures:
        if store.active != null:
            store.pending = store.active with bpm = bpm
    -- If a project is loaded, a new version with the updated BPM becomes pending
    -- and takes effect at the next loop boundary.
    -- If no project is loaded, the BPM is remembered in engine settings and applied
    -- when the next project is created.
}

-- Playback: standalone mode

rule LoopStart {
    when: LoopStart(operator)

    requires: engine.mode = standalone

    ensures:
        if store.active != null:
            engine.state = running
        else:
            engine.state = waiting
    -- In Waiting state the engine polls for a project and starts playback automatically
    -- as soon as CreateProject supplies one.
}

rule LoopStop {
    when: LoopStop(operator)

    requires: engine.mode = standalone

    ensures: engine.state = stopped
    -- All active notes receive NoteOff before the state transitions (see NotesSilenced).
}

-- Playback: clock mode
-- In clock mode the engine emits MIDI Timing Clock (0xF8) alongside notes.
-- LoopStart in clock mode behaves as ClockStart; LoopStop behaves as ClockStop (not ClockPause).
-- Pause and resume are only accessible via the dedicated ClockPause / ClockResume commands.

rule ClockStart {
    when: ClockStart(operator)

    requires: store.active != null

    ensures: engine.state = running
    -- 0xFA (MIDI Start) is emitted before the first 0xF8 (see ClockBoundaryMessages).
}

rule ClockPause {
    when: ClockPause(operator)

    requires: engine.state = running

    ensures: engine.state = paused
    -- All active notes receive NoteOff. No 0xFC is emitted; the clock is merely suspended.
}

rule ClockResume {
    when: ClockResume(operator)

    requires: engine.state = paused

    ensures: engine.state = running
    -- 0xFB (MIDI Continue) is emitted before the first resumed 0xF8 (see ClockBoundaryMessages).
}

rule ClockStop {
    when: ClockStop(operator)

    requires: engine.state = running or engine.state = paused

    ensures: engine.state = stopped
    -- 0xFC (MIDI Stop) is emitted. All active notes receive NoteOff.
}

-- Playback: sync mode
-- Playback is driven entirely by MIDI Realtime messages from an external clock device.
-- LoopStart and LoopStop are rejected in sync mode (see SyncModeRejectsDirectControl).

rule ExternalClockStart {
    when: MidiClockStart(clock)

    requires: engine.mode = sync

    ensures:
        if store.active != null:
            engine.state = running    -- playback restarts from loop start
        else:
            engine.state = waiting
    ensures: engine.sync_clock_status = tracking
    ensures: engine.last_pulse_at = null          -- pulse tracker resets on Start
    ensures: engine.last_pulse_interval = null    -- interval history cleared on Start
}

rule ExternalClockContinue {
    when: MidiClockContinue(clock)

    requires: engine.mode = sync
    requires: engine.is_clock_active  -- only acted on when pulses are still being received

    ensures:
        if store.active != null:
            engine.state = running    -- resumes from current loop position
        else:
            engine.state = waiting
}

rule ExternalClockStop {
    when: MidiClockStop(clock)

    requires: engine.mode = sync

    ensures: engine.state = stopped
    ensures: engine.sync_clock_status = waiting
    -- All active notes receive NoteOff.
}

rule ExternalClockPulse {
    when: MidiClockPulse(clock)

    requires: engine.mode = sync

    ensures: engine.sync_clock_status = tracking
    ensures: engine.last_pulse_interval = now - engine.last_pulse_at
    ensures: engine.last_pulse_at = now
    -- BPM is derived from inter-pulse timing and applied at the next loop boundary.
    -- last_pulse_interval is null on the first pulse because last_pulse_at was null (null arithmetic produces null).
}

rule ExternalClockLost {
    -- Fires when the expected inter-pulse interval has elapsed with no pulse received.
    -- Timeout = config.clock_loss_multiplier × the most recently observed pulse interval.
    when: engine: Engine.clock_loss_deadline <= now

    requires: engine.mode = sync
    requires: engine.sync_clock_status != lost

    ensures: engine.sync_clock_status = lost
    ensures: engine.state = stopped
    -- All active notes receive NoteOff. Engine stays stopped until a new Start arrives.
}

-- Mode switching

rule SetMode {
    when: SetMode(operator, new_mode)

    requires: new_mode in {standalone, clock, sync}
    requires:
        if new_mode = sync:
            -- sync mode requires the daemon to have been started with --sync and a MIDI port
            engine.sync_clock_status != null

    ensures:
        if engine.mode = clock
            and new_mode != clock
            and (engine.state = running or engine.state = paused):
            engine.state = stopped
            -- 0xFC is emitted and active notes receive NoteOff before the mode changes.
    ensures: engine.mode = new_mode
    -- Only the clock→non-clock direction stops the engine.
    -- All other mode switches (standalone↔sync, standalone→clock, sync→standalone)
    -- leave engine.state unchanged.
}

-- Daemon shutdown

rule DaemonStop {
    -- Triggered by the stop IPC command or SIGTERM.
    when: Stop(operator)

    ensures:
        if engine.state = running or engine.state = paused:
            engine.state = stopped
    -- If the engine was in clock mode, 0xFC is emitted before the socket is unlinked.
    -- All active notes receive NoteOff. IPC socket is removed after output is complete.
}

-- Status queries

rule ReportStatus {
    when: Status(operator)

    ensures: StatusReported(
        operator,
        bpm: store.active?.bpm ?? config.bpm_default,
        mode: engine.mode,
        state: engine.state
    )
}

rule ListPorts {
    when: ListMidiPorts(operator)

    ensures: MidiPortsListed(operator)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant NoteOffBeforeNoteOnAtSameTick {
    -- When a NoteOff and a NoteOn are scheduled at the same tick,
    -- NoteOff is always emitted first.
    -- This prevents stuck notes when consecutive notes share a tick boundary.
}

invariant NotesSilenced {
    -- Every NoteOn must be matched by a NoteOff before the engine transitions
    -- to the stopped or paused state.
    -- No note may be left sounding when the engine halts.
}

invariant ProgramChangeBeforeFirstNoteOn {
    -- At the start of each loop, a ProgramChange (instrument select) is emitted
    -- for any track whose instrument changed since the previous loop.
    -- On the very first loop, ProgramChange is sent for all tracks unconditionally.
    -- ProgramChange always precedes any NoteOn within the same loop.
}

invariant ClockBoundaryMessages {
    -- In clock mode:
    -- 0xFA (Start) is emitted once, before the first 0xF8 (Timing Clock) pulse.
    -- After ClockResume, 0xFB (Continue) is emitted before the first resumed 0xF8.
    -- 0xFC (Stop) is emitted once on ClockStop, after the final 0xF8.
}

invariant ClockPulseRate {
    -- In clock mode, one 0xF8 pulse is emitted every config.ppqn / config.clock_ppq ticks.
    -- This yields exactly 24 pulses per quarter note, conforming to MIDI 1.0.
}

invariant SyncModeRejectsDirectControl {
    -- In sync mode, LoopStart and LoopStop are rejected with an error response.
    -- In sync mode, SetBpm is rejected with an error response.
    -- Transport and tempo are controlled exclusively by the external MIDI clock device.
}

invariant PendingAppliedAtLoopBoundary {
    -- A pending project never interrupts a loop in progress.
    -- It becomes the active project only at the completion of the current loop.
    -- Exception: CreateProject immediately activates the project; no loop boundary wait.
}

invariant SyncRestartResetsLoopPosition {
    -- ExternalClockStart (MIDI 0xFA) always restarts playback from loop start,
    -- discarding any mid-loop position and resetting the cycle counter.
    -- ExternalClockContinue (MIDI 0xFB) resumes from the current loop position without resetting.
}

invariant ClockLossStopsPlayback {
    -- When the external clock signal is lost (ExternalClockLost fires),
    -- playback stops and all notes are silenced.
    -- The engine remains stopped until a new MIDI Start (0xFA) or Continue (0xFB) arrives
    -- from the external device.
}

invariant CrossLoopNoteCarryOver {
    -- A note whose start_tick + duration > loop_duration extends beyond the current loop iteration.
    -- The engine carries the sounding note into the next iteration and emits NoteOff
    -- at the tick (start_tick + duration) - loop_duration within the next loop.
    -- No note may span more than two loop iterations: duration ≤ 2 × loop_duration.
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Operator {}      -- human or script using the propeller CLI
actor ExternalClock {} -- MIDI device sending realtime clock messages (sync mode only)

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface OperatorInterface {
    facing operator: Operator

    provides:
        CreateProject(operator, data: ProjectData)
        ModifyProject(operator, data: ProjectData)
        SetBpm(operator, bpm: Integer)
        SetMode(operator, mode: EngineMode)
        LoopStart(operator)
        LoopStop(operator)
        ClockStart(operator)
        ClockPause(operator)
        ClockResume(operator)
        ClockStop(operator)
        ListMidiPorts(operator)
        Status(operator)
        Stop(operator)
}

surface MidiClockInput {
    -- Receives MIDI Realtime messages from the external clock device (sync mode only).
    -- Only 0xF8, 0xFA, 0xFB, 0xFC are processed; all other messages are ignored.
    facing clock: ExternalClock

    provides:
        MidiClockPulse(clock)     -- 0xF8 Timing Clock
        MidiClockStart(clock)     -- 0xFA Start
        MidiClockContinue(clock)  -- 0xFB Continue
        MidiClockStop(clock)      -- 0xFC Stop
}
